/* Application-wide Dark Theme */
QMainWindow {
    background-color: #1e1e1e;
    color: #d4d4d4;
}

/* Sidebar styling */
QTreeView {
    background-color: #252526;
    color: #cccccc;
    border: none;
    outline: none;
    font-size: 13px;
}
QTreeView::item {
    padding: 4px;
}
QTreeView::item:hover {
    background-color: #2a2d2e;
}
QTreeView::item:selected {
    background-color: #37373d;
    color: #ffffff;
}
QHeaderView::section {
    background-color: #252526;
    color: #cccccc;
    border: none;
    padding: 4px;
}

/* Chat display styling */
QTextBrowser {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #333333;
    border-radius: 4px;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 14px;
    padding: 10px;
}

/* Input box styling */
QTextEdit {
    background-color: #2d2d30;
    color: #d4d4d4;
    border: 1px solid #3f3f46;
    border-radius: 4px;
    padding: 8px;
    font-size: 14px;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}
QTextEdit:focus {
    border: 1px solid #007fd4;
}

/* Send button styling */
QPushButton {
    background-color: #0e639c;
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #1177bb;
}
QPushButton:pressed {
    background-color: #094771;
}

/* Splitter styling (the draggable bar between sidebar and chat) */
QSplitter::handle {
    background-color: #333333;
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:hover {
    background-color: #007fd4;
}

/* Toolbar styling */
QToolBar {
    background-color: #252526;
    border: none;
    border-bottom: 1px solid #333333;
    padding: 5px;
}

QToolBar QComboBox {
    background-color: #3c3c3c;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    padding: 4px;
    min-width: 150px;
}

QToolBar QComboBox::drop-down {
    border: none;
}

QToolBar QToolButton {
    background-color: transparent;
    color: #cccccc;
    padding: 6px 10px;
    border-radius: 3px;
    margin: 0 2px;
}

QToolBar QToolButton:hover {
    background-color: #37373d;
    color: #ffffff;
}

QToolBar QToolButton:pressed {
    background-color: #094771;
}
